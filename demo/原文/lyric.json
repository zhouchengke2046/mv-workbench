{
  "title": "末班地铁",
  "lines": [
    {
      "line_id": "L01",
      "text": "末班地铁关上门"
    },
    {
      "line_id": "L02",
      "text": "站台只剩一盏灯"
    },
    {
      "line_id": "L03",
      "text": "耳机里下起小雨"
    },
    {
      "line_id": "L04",
      "text": "把整座城市调成静音"
    },
    {
      "line_id": "L05",
      "text": "走过天桥和路灯"
    },
    {
      "line_id": "L06",
      "text": "走过没写完的梦"
    },
    {
      "line_id": "L07",
      "text": "如果世界太吵"
    },
    {
      "line_id": "L08",
      "text": "就把音量调到刚刚好"
    },
    {
      "line_id": "L09",
      "text": "便利店的灯还亮"
    },
    {
      "line_id": "L10",
      "text": "店员打了一个哈欠"
    },
    {
      "line_id": "L11",
      "text": "我把今天折进口袋"
    },
    {
      "line_id": "L12",
      "text": "明天再慢慢拆开"
    },
    {
      "line_id": "L13",
      "text": "雨停在耳机外面"
    },
    {
      "line_id": "L14",
      "text": "我走进自己的夜"
    }
  ]
}