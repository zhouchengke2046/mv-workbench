{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standard Storyboard (per MV)",
  "description": "每条 MV 一份标准分镜（由歌词+故事脚本派生）；原文故事脚本不拆镜，分镜表才拆。每镜必须有景别、运镜、画面描述、时长。",
  "type": "object",
  "required": ["workbench_id", "mv_id", "version", "shots"],
  "properties": {
    "workbench_id": {"type": "string"},
    "mv_id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "locked"], "default": "locked"},
    "source": {"type": "string"},
    "created_at": {"type": "string"},
    "note": {"type": "string"},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "line_ids", "shot_size", "camera", "visual", "duration"],
        "properties": {
          "shot_id": {"type": "string"},
          "line_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^L[0-9]+$"}
          },
          "shot_size": {"type": "string", "description": "景别：中景/近景/特写/全景/双人中景/大全景等"},
          "camera": {"type": "string", "description": "运镜：固定机位/轻微手持/跟拍/侧前方跟拍等"},
          "visual": {"type": "string", "description": "画面描述（动作+构图）"},
          "duration": {"type": "number", "minimum": 0},
          "characters": {"type": "array", "items": {"type": "string"}},
          "scene": {"type": "string"},
          "props": {"type": "array", "items": {"type": "string"}},
          "candidates": {"type": "integer", "minimum": 1, "default": 1},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
