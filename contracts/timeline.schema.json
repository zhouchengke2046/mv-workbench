{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MV Timeline",
  "description": "音乐阶段产物：每一句歌词在歌词段内的起止秒。start/end 相对歌词段起点（前奏之后），不是歌曲绝对时间。",
  "type": "object",
  "required": ["mv_id", "duration", "lines"],
  "properties": {
    "mv_id": {"type": "string"},
    "song": {"type": "string", "description": "歌曲文件路径；相对 media_root 或绝对路径"},
    "media_root": {"type": "string"},
    "duration": {"type": "number", "minimum": 0, "description": "歌词段总时长（不含前奏）"},
    "intro": {"type": "number", "minimum": 0, "default": 0, "description": "前奏时长；歌曲绝对时间 = intro + start"},
    "fps": {"type": "number", "default": 30},
    "size": {"type": "string", "default": "1080x1920"},
    "aligned_by": {"type": "string", "description": "whisperx / onset / manual / proportional"},
    "version": {"type": "integer", "minimum": 1, "default": 1},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["line_id", "text", "start", "end"],
        "properties": {
          "line_id": {"type": "string", "pattern": "^L[0-9]+$"},
          "text": {"type": "string"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
